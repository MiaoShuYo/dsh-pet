{
  "name": "dsh-pet",
  "version": "0.7.9",
  "private": true,
  "description": "A Windows desktop pet for DeepSeek Harness: always-on-top pet, live tasks, balance/token plaque, native settings and double-click to open DSH.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/skins.md",
    "docs/QA.md",
    "docs/preview.svg",
    "docs/tasks.png",
    "docs/desktop.png",
    "docs/settings.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0",
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "market:index": "node scripts/market-index.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "desktop-pet",
    "tokens",
    "balance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiaoShuYo/dsh-pet.git"
  },
  "homepage": "https://github.com/MiaoShuYo/dsh-pet#readme",
  "bugs": {
    "url": "https://github.com/MiaoShuYo/dsh-pet/issues"
  },
  "author": "DSH Pet contributors",
  "license": "MIT"
}
