{
  "name": "dsh-pet",
  "version": "0.1.0",
  "private": true,
  "description": "An in-app desktop pet for DeepSeek Harness: balance, token usage, context pressure, alerts, stats and skins.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/skins.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0",
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "market:index": "node scripts/market-index.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "desktop-pet",
    "tokens",
    "balance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/dsh-pet.git"
  },
  "homepage": "https://github.com/OWNER/dsh-pet#readme",
  "bugs": {
    "url": "https://github.com/OWNER/dsh-pet/issues"
  },
  "author": "DSH Pet contributors",
  "license": "MIT"
}
